# Copy to .env and fill in. Never commit .env.

# Domain that serves the links (must already point at this host's IP).
SHORT_DOMAIN=go.example.com
# Address for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com

# Bearer tokens the API accepts, comma-separated for rotation.
# Generate: openssl rand -hex 24
SHORTENER_API_KEYS=

# Bind address. Containers must use 0.0.0.0.
SHORTENER_BIND=0.0.0.0:8080
# Public base URL used to build returned short links (no trailing slash).
SHORTENER_PUBLIC_BASE_URL=https://go.example.com
# SQLite path; the volume mount keeps it across restarts.
SHORTENER_DB=/data/shortener.db
# Generated slug length (4-32).
SHORTENER_SLUG_LEN=7
RUST_LOG=shortener=info,tower_http=info,warn
