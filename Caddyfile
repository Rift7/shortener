{
	email {$ACME_EMAIL}
}

{$SHORT_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy shortener:8080 {
		header_up X-Real-IP {remote_host}
	}

	log {
		output stdout
		format console
	}
}
